# Variáveis do SERVIDOR Next (nunca expostas ao navegador). Validadas em src/shared/config/env.server.ts.

# URL da API .NET.
# - `dotnet run` (perfil HTTP): http://localhost:5038
# - docker-compose do backend:  http://localhost:8080
BACKEND_URL=http://localhost:5038
BACKEND_API_PREFIX=/api/v1

# Tempo limite das chamadas à API, em milissegundos (opcional; padrão 15000).
BACKEND_TIMEOUT_MS=15000

# Importante: atrás deste BFF, a API precisa de ForwardedHeaders__Enabled=true.
# Sem isso, todos os usuários dividem o limite de requisições do IP do servidor Next
# e a auditoria grava o IP errado.

# Origens públicas do app, separadas por vírgula (opcional). Use quando o Next roda atrás de um proxy
# e a Origin do navegador difere da URL interna. O CSRF do BFF aceita a própria origem e estas.
# APP_ORIGINS=https://pethost.app

# Checkout de teste da estadia (066). Nunca definir uma chave secreta neste env público.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
